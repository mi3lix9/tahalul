{
  "expo": {
    "scheme": "tahalul",
    "sdkVersion": "55.0.0",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "bundler": "metro"
    },
    "name": "tahalul",
    "slug": "tahalul",
    "plugins": [
      "expo-font",
      "expo-camera",
      "expo-image-picker",
      "expo-notifications",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a1a2e"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.mi3lix9.tahalul"
    },
    "ios": {
      "bundleIdentifier": "com.mi3lix9.tahalul"
    }
  }
}
